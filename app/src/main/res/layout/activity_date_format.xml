<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/textDateFormatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="35dp"
            android:paddingBottom="20dp"
            android:text="@string/date_format_title"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDateFormatEU"
            android:layout_width="280dp"
            android:layout_height="135dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/expirely_onPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/expirely_primary"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDateFormatUS"
            android:layout_width="280dp"
            android:layout_height="135dp"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/expirely_onPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/expirely_primary"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

    </LinearLayout>

</ScrollView>