<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settingsList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/rowSecurity"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/rowLanguage"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/rowDateFormat"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/rowBackup"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/rowHistory"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/rowMoreApps"
            layout="@layout/item_settings_row" />

        <include
            android:id="@+id/rowAdmin"
            layout="@layout/item_settings_row" />

    </LinearLayout>

</ScrollView>
