<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AllIsOK" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Widget.AllIsOK.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_rounded_popup</item>
        <item name="android:popupElevation">12dp</item>
        <item name="android:textColor">#111111</item>
        <item name="android:itemTextAppearance">@style/AllIsOK.PopupMenuItemText</item>
    </style>

    <style name="AllIsOK.PopupMenuItemText" parent="@android:style/TextAppearance.Material.Menu">
        <item name="android:textColor">#111111</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AllIsOK.DialogTitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#111111</item>
    </style>

    <style name="AllIsOK.DialogBodyText" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#111111</item>
    </style>

    <style name="AllIsOK.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">#FFFFFF</item>
        <item name="android:textColorPrimary">#111111</item>
        <item name="android:textColorSecondary">#333333</item>
        <item name="android:textColor">#111111</item>
        <item name="listItemLayout">@layout/dialog_list_item</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AllIsOK.DialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/AllIsOK.DialogBodyText</item>
        <item name="android:textSize">16sp</item>
        <item name="buttonBarNegativeButtonStyle">@style/AllIsOK.DialogButton</item>
    </style>

    <style name="AllIsOK.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AllIsOK.DialogButton.CareDays" parent="AllIsOK.DialogButton">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="AllIsOK.MaterialAlertDialog.CareDays" parent="AllIsOK.MaterialAlertDialog">
        <item name="android:background">@drawable/bg_care_select_days_dialog</item>
        <item name="listItemLayout">@layout/dialog_list_item_care_days</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Material3.Title.Text</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="colorControlActivated">#000000</item>
        <item name="buttonBarNegativeButtonStyle">@style/AllIsOK.DialogButton.CareDays</item>
        <item name="buttonBarPositiveButtonStyle">@style/AllIsOK.DialogButton.CareDays</item>
    </style>

    <style name="AllIsOK.DatePickerDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@drawable/bg_care_select_days_dialog</item>
        <item name="colorSurface">@android:color/transparent</item>
        <item name="colorOnSurface">#111111</item>
        <item name="colorPrimary">#7C6FA0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="colorControlNormal">#FFFFFF</item>
        <item name="buttonBarNegativeButtonStyle">@style/AllIsOK.DialogButton.CareDays</item>
        <item name="buttonBarPositiveButtonStyle">@style/AllIsOK.DialogButton.CareDays</item>
    </style>

    <style name="AllIsOK.TimePickerDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@drawable/bg_care_select_days_dialog</item>
        <item name="colorSurface">@android:color/transparent</item>
        <item name="colorOnSurface">#111111</item>
        <item name="colorPrimary">#7C6FA0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="android:timePickerStyle">@style/AllIsOK.TimePickerDialog.TimePicker</item>
        <item name="buttonBarNegativeButtonStyle">@style/AllIsOK.DialogButton.CareDays</item>
        <item name="buttonBarPositiveButtonStyle">@style/AllIsOK.DialogButton.CareDays</item>
    </style>

    <style name="AllIsOK.TimePickerButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#111111</item>
    </style>

</resources>